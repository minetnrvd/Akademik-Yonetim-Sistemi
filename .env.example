# Environment variables read by app.py.
# Copy this file to .env (next to app.py); it is loaded at startup.
# Variables already set in the shell take precedence over .env values.
# Only DATABASE_URL is required; commented lines show the built-in default.

# --- Core ---
# Required in any shared/production setup; the fallback is a fixed development key.
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# 1 = Flask debug mode (never in production)
# FLASK_DEBUG=0
# Required: PostgreSQL connection URL (the only supported database).
DATABASE_URL=postgresql://postgres:password@localhost:5432/attendance

# --- QR attendance ---
# URL encoded into class QR codes; phones must reach it. Default: http://<detected LAN IP>:5000
# QR_BASE_URL=http://192.168.1.25:5000
# How long a QR attendance session stays open (minutes)
# ATTENDANCE_WINDOW_MINUTES=180
# 1 = redirect requests to the QR_BASE_URL host
# FORCE_CANONICAL_HOST=0

# --- Session / cookies ---
# SESSION_COOKIE_NAME=qr_attendance_session
# Lax | Strict | None
# SESSION_COOKIE_SAMESITE=Lax
# 1 = cookies only over HTTPS
# SESSION_COOKIE_SECURE=0
# REMEMBER_ME_DAYS=30

# --- Security limits ---
# PASSWORD_MIN_LENGTH=10
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=8
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# LOGIN_LOCK_MAX_FAILURES=5
# LOGIN_LOCK_WINDOW_SECONDS=900
# ADMIN_MUTATION_RATE_LIMIT_MAX=30
# ADMIN_MUTATION_RATE_LIMIT_WINDOW_SECONDS=60

# --- Email (dry run by default: messages are logged, not sent) ---
# EMAIL_DRY_RUN=1
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_FROM=noreply@qr-attendance.local
# EMAIL_TIMEOUT_SECONDS=10

# --- Logging ---
# Default: ./logs
# APP_LOG_DIR=
# APP_LOG_FILE=app.log
# DEBUG | INFO | WARNING | ERROR
# APP_LOG_LEVEL=INFO
# APP_LOG_MAX_BYTES=5242880
# APP_LOG_BACKUP_COUNT=7

# --- Health / metrics thresholds ---
# METRICS_SLOW_REQUEST_MS=750
# HEALTH_WARN_ERROR_RATE_PCT=5
# HEALTH_WARN_P95_MS=1000
